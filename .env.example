# Firebase Config (Client-side variables prefixed with VITE_)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Firebase Admin SDK (Server-side only — set in Vercel Environment Variables)
# Option A: Individual fields from your Firebase Service Account JSON
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_ID=""

# Option B: Or paste the entire Service Account JSON string
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Telegram Bot (Server-side only)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# Gemini AI for natural language transaction parsing (Optional, Server-side only)
GEMINI_API_KEY=""

# Vercel Cron security secret (Optional, recommended)
CRON_SECRET=""
